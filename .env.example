# ─── ErbilRate API — Environment Configuration ────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# ── PostgreSQL Database ────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
# Recommended: Neon (neon.tech) — free serverless Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/erbilrate

# ── Redis Cache ────────────────────────────────────────────────────────────────
# Format: redis://[:password@]host[:port][/db-number]
# Recommended: Upstash (upstash.com) — free serverless Redis
# Use rediss:// (with double s) for TLS connections
REDIS_URL=redis://localhost:6379/0

# ── Clerk Authentication ───────────────────────────────────────────────────────
# Used to verify RS256 JWTs issued by Clerk for admin dashboard access.
# Find in: Clerk Dashboard → API Keys → Advanced → Frontend API URL
# Example: https://fast-midge-51.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://your-instance.clerk.accounts.dev

# ── CORS — Allowed Origins ─────────────────────────────────────────────────────
# Comma-separated list of origins allowed to make cross-origin API requests.
# Production: set to your actual domain(s)
# Dev default (used if unset): http://127.0.0.1:8000,http://localhost:8000
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Data Source ────────────────────────────────────────────────────────────────
# ErbilRate API is data-source agnostic. The hosted service at erbilrate.com
# uses a proprietary real-time data pipeline. For self-hosting, connect your
# own data ingestion logic to the exchange_rates table defined in app/db/connection.py.
# See: https://github.com/abdulhadikamaran/erbilrate-api/blob/main/app/db/connection.py
